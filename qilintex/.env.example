# 基础服务
HOST=0.0.0.0
PORT=4318
COLLAB_PORT=4319
CLIENT_URL=http://localhost:5173
# 多个内网/公网前端入口用逗号分隔；第一个地址用于生成邀请链接
CLIENT_URLS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4318
PUBLIC_COLLAB_URL=ws://localhost:4319
SESSION_SECRET=请替换为至少32位随机字符串
ALLOW_DEV_LOGIN=true

# 内部团队登录：无需第三方开放平台审核。生产环境必须设置 TEAM_ACCESS_CODE
TEAM_NAME=数模团队
TEAM_ACCESS_CODE=

# QQ 互联（网站应用）
QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=http://localhost:4318/auth/qq/callback

# 微信开放平台（网站应用）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://localhost:4318/auth/wechat/callback

# AI Agent（仅放在服务端，禁止写入客户端）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# 可分别关闭云端代码绘图或生成式图片；默认开启
OPENAI_CODE_INTERPRETER=true
OPENAI_IMAGE_GENERATION=true
# 每次 Agent 回复最多回传的图形数量与单文件字节数
OPENAI_MAX_ARTIFACTS=4
OPENAI_MAX_ARTIFACT_BYTES=8000000

# LaTeX 编译器。推荐 Tectonic，也可填 latexmk 可执行文件路径
TEX_ENGINE=tectonic
TEX_ENGINE_PATH=
# 使用 latexmk 编译中文文档时建议设为 xelatex。
TEX_LATEXMK_ENGINE=xelatex

# 桌面更新源（electron-builder generic provider）
UPDATE_URL=

# 移动端应用商店地址
APP_LATEST_VERSION=0.1.0
APP_RELEASE_NOTES=
ANDROID_STORE_URL=
IOS_STORE_URL=
