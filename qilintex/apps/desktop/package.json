{
  "name": "@tonggao/desktop",
  "productName": "Qilintex",
  "version": "0.1.0",
  "private": true,
  "description": "多人实时协作 LaTeX 与 AI 写作工作台",
  "author": "sunrise690",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "package:win": "electron-builder --win nsis portable --x64",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node --check main.mjs && node --check preload.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cn.tonggao.tex",
    "productName": "Qilintex",
    "asar": true,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "main.mjs",
      "preload.mjs",
      "protocol.mjs",
      "package.json"
    ],
    "extraResources": [
      { "from": "../client/dist", "to": "web" },
      { "from": "../server/dist/bundle.cjs", "to": "server/bundle.cjs" }
    ],
    "protocols": [
      { "name": "Qilintex 登录", "schemes": ["tonggaotex"] }
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Qilintex-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Qilintex-Portable-${version}-${arch}.${ext}"
    }
  }
}
