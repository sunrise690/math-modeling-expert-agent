[Unit]
Description=QilinTeX collaboration server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=qilintex
Group=qilintex
WorkingDirectory=/opt/qilintex/current/apps/server
EnvironmentFile=/etc/qilintex/qilintex.env
ExecStart=/usr/bin/node /opt/qilintex/current/apps/server/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qilintex
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
