[Unit]
Description=QilinTeX collaboration server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_ROOT__/apps/server
EnvironmentFile=__CONFIG_ROOT__/qilintex.env
ExecStart="__NODE_BIN__" "__APP_ROOT__/apps/server/dist/index.js"
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__DATA_ROOT__
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
