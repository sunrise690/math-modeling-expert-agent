# 数模工作台统一环境变量示例（UTF-8）
# 根目录 .env 同时供 QilinTeX 协作服务与数模 Agent 使用；qilintex/.env 可作为协作服务的可选覆盖层。

# 统一前端与协作服务
WORKBENCH_URL=http://localhost:5173
HOST=0.0.0.0
PORT=4318
COLLAB_PORT=4319
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4318
PUBLIC_COLLAB_URL=ws://localhost:4319
# 仅用于前端与 API 不同源的构建；同源 Web 部署保持留空。
QILINTEX_CLIENT_API_URL=
QILINTEX_CLIENT_COLLAB_URL=
SESSION_SECRET=请替换为至少32位随机字符串
ALLOW_DEV_LOGIN=true
TEAM_NAME=数模团队
TEAM_ACCESS_CODE=
# 留空时使用 qilintex/apps/server/data；相对路径以协作服务目录为基准。
DATA_DIR=

# 数模 Agent 内部地址；一键启动器会从这里自动取得端口。
MATH_MODELING_AGENT_URL=http://127.0.0.1:8765
QILINTEX_AGENT_BACKEND=math-modeling

# 数模 Agent
# 默认 AGENT_CONFIG_LOCK=0：数模后端的本地配置接口可以覆盖下列 Provider 运行值。
# 设为 1 后仅使用 .env/进程环境；此时直接填写的 API Key 是明文，请妥善保护 .env。
AGENT_CONFIG_LOCK=0

# 当前 Provider：codex-cli | openai-responses | deepseek | openai-compatible | ollama
AGENT_PROVIDER=codex-cli
AGENT_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=

# Codex 当前登录账号模式。留空时使用 openai-codex 随附 runtime 或 PATH 中的独立 Codex CLI。
# 此模式读取官方 Codex 登录状态，不使用 AGENT_API_KEY。
AGENT_CODEX_CLI_PATH=
# 1 使用低延迟 HTTPS 兼容传输；0 使用 Codex Runtime 默认传输（当前可能先经历 WebSocket 回退）。
AGENT_CODEX_FAST_HTTP=1

# 模型调用
AGENT_TIMEOUT=180
# none | low | medium | high | xhigh | max；Codex 还接受 ultra（以账号模型列表为准）
AGENT_REASONING_EFFORT=medium
AGENT_TEXT_VERBOSITY=medium
AGENT_RESPONSE_STORE=0
AGENT_TOOLS=1

# 质量闭环与任务队列
AGENT_QUALITY=1
AGENT_QUALITY_THRESHOLD=82
AGENT_MAX_REVISIONS=1
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_MAX_QUEUED_RUNS=20

# 运行数据目录。留空时使用仓库相对的 .agent-data/；相对路径以仓库根目录为基准。
# 部署到只读源码目录时可设置到系统用户数据目录。
AGENT_DATA_DIR=

# 本地资料库。未设置时自动使用仓库根目录下的 knowledge/，无需配置绝对路径。
# 可填写相对仓库根目录的路径；多目录使用当前系统的路径分隔符（Windows 为分号，macOS/Linux 为冒号）。
# AGENT_KNOWLEDGE_ROOTS=knowledge
# 专业 skill 通过 search_skills/read_skill/read_skill_reference 独立读取；默认不混入资料全文索引。
AGENT_KNOWLEDGE_INCLUDE_SKILLS=0

# MATLAB / Origin MCP
AGENT_MCP=1
AGENT_MATLAB_MCP=1
AGENT_ORIGIN_MCP=1
# 本地 MATLAB -batch 执行；与 MCP 开关相互独立。
AGENT_MATLAB_LOCAL=1
# 任意 MATLAB 源码会获得当前用户的本机权限且没有安全沙箱；默认严禁模型调用。
# 只在操作员已审查任务与代码、接受本机任意代码风险时临时改为 1。
AGENT_UNSANDBOXED_MATLAB=0
# MATLAB 单次执行上限；Codex MCP 与工具代理会据此设置更长的联动超时。
AGENT_MATLAB_TIMEOUT=180
# MATLAB_ROOT=（可选：MATLAB 安装目录或可执行文件；优先自动从 PATH 和系统安装目录发现）
# 2025 A 题默认复用已核验的 42 个 MATLAB 图件；取消注释可强制全量重绘。
# CUMCM_FORCE_MATLAB_FIGURES=1

# 五种 Provider 的手工配置示例。一次只取消一个区块的注释，并同步替换上面的当前值。

# 1) Codex 当前登录账号：无需 API Key 和基础 URL
# AGENT_PROVIDER=codex-cli
# AGENT_MODEL=gpt-5.6-sol
# AGENT_BASE_URL=
# AGENT_API_KEY=

# 2) OpenAI Responses API：使用独立 OpenAI API Key
# AGENT_PROVIDER=openai-responses
# AGENT_MODEL=gpt-5.6-sol
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_API_KEY=

# 3) DeepSeek：使用独立 DeepSeek API Key
# AGENT_PROVIDER=deepseek
# AGENT_MODEL=deepseek-chat
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_API_KEY=

# 4) OpenAI Chat Completions 兼容接口
# 远程接口必须使用 HTTPS；只有 localhost/127.0.0.1 等回环地址允许 HTTP。
# AGENT_PROVIDER=openai-compatible
# AGENT_MODEL=your-model-name
# AGENT_BASE_URL=https://your-provider.example/v1
# AGENT_API_KEY=

# 5) Ollama 本地模型：通常无需 API Key
# AGENT_PROVIDER=ollama
# AGENT_MODEL=qwen3:8b
# AGENT_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_API_KEY=
