  "subquestions": [
    {
      "subquestion_id": "Q1",
      "task_types": [
        "prediction"
      ],
      "goal": "量化男胎 Y 染色体浓度与孕周、BMI 及质量协变量的关系，并正确处理同一孕妇的重复测量相关。"
    },
    {
      "subquestion_id": "Q2",
      "task_types": [
        "optimization",
        "grouping"
      ],
      "goal": "在首次达到 4% Y 浓度的时间存在删失时，确定连续 BMI 分组及满足 90% 预测达标率的最早检测孕周。"
    },
    {
      "subquestion_id": "Q3",
      "task_types": [
        "optimization",
        "grouping"
      ],
      "goal": "在不使用检测后变量的前提下引入年龄、身高、受孕方式和孕产史，对 BMI 分组时点进行多因素风险修正和误差分析。"
    },
    {
      "subquestion_id": "Q4",
      "task_types": [
        "classification",
        "prediction",
        "evaluation",
        "simulation"
      ],
      "goal": "基于常染色体 Z 值、X 染色体和测序质量指标判定女胎异常，并在阳性不平衡和重复检测条件下评价模型。"
    }
  ],
